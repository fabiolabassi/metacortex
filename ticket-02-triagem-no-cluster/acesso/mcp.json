{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes@4.1.9"],
      "env": {
        "ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS": "true",
        "ALLOWED_TOOLS": "kubectl_get,kubectl_describe,kubectl_logs,explain_resource,list_api_resources,ping",
        "KUBECONFIG": "${HOME}/.kube/triagem-leitura.yaml"
      }
    }
  }
}
